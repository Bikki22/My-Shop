# ---- Clerk ----------------------------------------------------------------
# Both keys come from the SAME Clerk application the Express server uses,
# otherwise the server rejects the tokens this app sends.
# https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Required, not optional: the proxy runs before React, so it cannot see the
# ClerkProvider props — without these it redirects guests to Clerk's hosted
# sign-in portal instead of the local pages. Keep in sync with config/routes.ts.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- API ------------------------------------------------------------------
# Base URL of the Express server. The /api/v1 prefix is added by lib/api/http.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
