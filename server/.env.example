# Copy to .env and fill in. Values are validated at startup by
# src/app/config/env.ts — the server refuses to boot if a required one
# is missing, rather than failing later on the first request.

# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/my-shop
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Optional ---
NODE_ENV=development
PORT=8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Marketplace economics ---
# The platform's cut of every sale, as a fraction, for shops with no
# negotiated rate of their own. An admin can override it per shop via
# PATCH /api/v1/vendors/admin/:id/commission.
PLATFORM_COMMISSION_RATE=0.1

# Delivery is charged PER SHOP: a basket from three shops is three parcels
# from three warehouses, so each sub-order is quoted its own fee.
SHIPPING_FLAT_FEE=49
FREE_SHIPPING_THRESHOLD=999

# Fraction of the subtotal, e.g. 0.13 for 13%.
TAX_RATE=0

# Only needed by POST /webhooks/clerk. While it is unset that one route
# answers 503 and the rest of the API runs normally. Get it from the
# Clerk Dashboard under Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=

# Where the browser is sent after checkout and after an eSewa redirect.
# Must be reachable from the customer's machine, not from the container.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000

# --- eSewa ePay v2 ---
# Unset = the /api/v1/payments routes answer 503; everything else runs.
# test        -> https://rc-epay.esewa.com.np (sandbox)
# production  -> https://epay.esewa.com.np (live; needs real credentials)
ESEWA_ENV=test
# Sandbox values published by eSewa. Replace both in production.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# --- Cloudinary (image uploads) ---
# Unset = POST /api/v1/products/:id/images answers 503; everything else
# runs, and products can still be created with image URLs hosted elsewhere.
# From the Cloudinary dashboard. The API secret signs upload and delete
# calls — it must never be sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (transactional email) ---
# Unset = outgoing mail is logged instead of sent. Nothing fails because of
# it: an order that was placed is still placed if its receipt didn't go out.
RESEND_API_KEY=
# `Name <address>`, or a bare address. Resend rejects domains that aren't
# verified on the account; the default below is their shared sandbox sender,
# which only delivers to the address that owns the Resend account.
EMAIL_FROM=My Shop <onboarding@resend.dev>

# --- App-signed tokens (src/app/utils/jwt.ts) ---
# NOT the login path — sessions belong to Clerk. These sign the narrower
# things a session can't carry: a one-shot link mailed to someone who isn't
# signed in, a short-lived grant for another service. Unset = utils/jwt.ts
# refuses to sign, rather than falling back to a secret baked into the repo.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters, and use a different value for each.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Anything jsonwebtoken accepts for expiresIn: "15m", "7d", "3600".
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
